{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kianchales/ibd-skills/skills/ibd-doc-review/references/problems.schema.json",
  "title": "复核问题清单条目 schema",
  "description": "ibd-doc-review 复核问题清单（JSON 数组）条目级结构契约。语义源 = interface.md §3；类型词表语义源 = annotations.md §4。本文件是机器可执行版，两处规范源变更时须同步本文件并 bump 次版本 + CHANGELOG 登记。",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["anchor", "type", "sev", "title", "desc"],
    "anyOf": [
      {"required": ["advice"]},
      {"required": ["rev"]}
    ],
    "additionalProperties": false,
    "properties": {
      "anchor": {
        "type": "string",
        "minLength": 1,
        "description": "原文问题句段的精确子串，最小可定位文本"
      },
      "type": {
        "type": "string",
        "enum": [
          "数据·口径",
          "数据·勾稽",
          "数据·完整性",
          "数据·正负号",
          "表述·绝对化",
          "表述·衔接",
          "表述·歧义",
          "披露·充分性",
          "披露·时效",
          "合规·一致性",
          "合规·禁用表述",
          "合规·来源限定"
        ],
        "description": "固定 12 项词表，新增须在 annotations.md §4 登记，禁止自造标签"
      },
      "sev": {
        "type": "string",
        "enum": ["高", "中", "低"],
        "description": "高=必改 / 中=应改 / 低=建议改。升档规则（双维度取高）见 annotations.md §4：合规·禁用表述/来源限定恒「高」；涉审核关注点的披露充分性问题升「高」"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "问题短标题"
      },
      "desc": {
        "type": "string",
        "minLength": 1,
        "description": "问题描述"
      },
      "advice": {
        "type": "string",
        "minLength": 1,
        "description": "指令式修改建议（如「核对…后统一…」）。与 rev 二者至少其一（anyOf）。文本定稿形态下 advice 可与 rev 同源（承载可直接粘贴的定稿文本）"
      },
      "author": {
        "type": "string",
        "description": "复核人名（可选）"
      },
      "code": {
        "type": "string",
        "pattern": "^[A-Z]{1,2}$",
        "description": "1-2 位大写字母前缀，缺省回退 U"
      },
      "rev": {
        "type": "string",
        "description": "**可直接粘贴的替换文本**（不是指令式建议）。**必填形态**：文本定稿形态（逐条「原文→改后」）与修订稿形态——文本定稿形态下 rev 为主交付物、advice 可省；批注形态下 rev 可缺（缺则入总览「待人工定位/待定稿」）"
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "description": "PDF 限定页"
      }
    }
  }
}
